# AI: Google AI Studio (Gemini) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
# OpenAI-compatible endpoint of the Gemini API. Clear AI_BASE_URL (and set
# AI_MODEL) to use OpenAI with OPENAI_API_KEY instead.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

TELEGRAM_BOT_TOKEN=
DATABASE_PATH=data/outreach.db
EXCEL_PATH=data/Outreach_Tracker.xlsx
STUDENT_NAME=Daksh Khandagale
STUDENT_COLLEGE=Universal AI University, Karjat
STUDENT_ROLE=Student involved in student-industry engagement
DEFAULT_FOLLOWUP_DAYS=7
LOG_LEVEL=INFO
# Comma-separated Telegram user IDs allowed to use the bot (required).
# The bot replies with your ID if it is missing, so you can add yourself.
TELEGRAM_ALLOWED_USER_IDS=
